# JGasFlow Online API (local development)
NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Karachi
# Comma-separated browser origins. Empty = local dev ports.
CORS_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jgasflow

# Signs nothing secret-bearing on the client, used to hash session tokens.
TOKEN_SECRET=
SESSION_DAYS=60


TRIAL_DAYS=14
# Shown on the Subscription page for manual payments.
PAY_JAZZCASH=0300-0000000 (JGasFlow)
PAY_EASYPAISA=0300-0000000 (JGasFlow)
PAY_BANK=Bank: Meezan Bank, Title: JGasFlow, IBAN: PK00MEZN0000000000000000
PAY_WHATSAPP=0300-0000000

# Shop web app address (support login links)
SHOP_APP_URL=http://localhost:5002

# AI assistant (console). Keys can also be set in the console under AI settings.
GEMINI_API_KEY=
GEMINI_MODEL=
# Encrypts AI keys stored in the database; keep it stable.
AI_SECRET_KEY=
AI_CONFIRM_SECRET=
AI_LIVE_SECRET=
VOICE_API_KEY=
