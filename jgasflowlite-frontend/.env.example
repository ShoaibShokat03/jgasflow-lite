# API base URL. Leave empty in development: Vite proxies /api to the local
# API (VITE_DEV_API_TARGET). In production point it at the API, e.g.
# VITE_API_URL=https://api.jgasflow.com/api
VITE_API_URL=

# Where the dev proxy sends /api (default http://localhost:5000)
VITE_DEV_API_TARGET=http://localhost:5000
